# =============================================================================
# LocalMart - Environment Configuration
# =============================================================================

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=LocalMart
NEXT_PUBLIC_APP_DESCRIPTION=All local shops in one place
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/localmart
MONGODB_DB_NAME=localmart

# Authentication
AUTH_SECRET=your-super-secret-key-change-in-production
AUTH_TOKEN_EXPIRY=7d
AUTH_REFRESH_TOKEN_EXPIRY=30d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# Payment - bKash (leave empty for sandbox simulation mode)
BKASH_ENV=sandbox            # sandbox | production
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# Payment - Nagad (leave empty for sandbox simulation mode)
NAGAD_ENV=sandbox            # sandbox | production
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_NUMBER=
NAGAD_PUBLIC_KEY=
NAGAD_PRIVATE_KEY=

# Payment - SSLCommerz (leave empty for sandbox simulation mode)
SSLCOMMERZ_ENV=sandbox       # sandbox | production
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# SMS Provider - Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Email Provider - SendGrid
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@localmart.app
SENDGRID_FROM_NAME=LocalMart

# Redis / Caching & Queue (leave empty for in-memory fallback)
REDIS_URL=redis://localhost:6379

# Realtime (socket.io custom server)
SOCKET_PATH=/socket.io

# Loyalty & Referral rewards (points)
REFERRER_REWARD_POINTS=100
REFERRED_REWARD_POINTS=50

# AI Provider (optional - features gracefully disabled when not configured)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_MAX_TOKENS=2000

# Maps Provider (optional)
MAPS_PROVIDER=
MAPS_API_KEY=

# Feature Flags (overridden by database config)
ENABLE_COD=true
ENABLE_BKASH=false
ENABLE_NAGAD=false
ENABLE_AI=false
ENABLE_PLATFORM_DELIVERY=true
ENABLE_SELLER_DELIVERY=true
ENABLE_SELF_PICKUP=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE_MB=5
MAX_IMAGE_SIZE_MB=10

# Demo Mode
DEMO_MODE=true
DEMO_ADMIN_EMAIL=admin@localmart.com
DEMO_ADMIN_PASSWORD=Admin123!
