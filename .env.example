# =============================================================================
# LocalMart - Environment Configuration
# =============================================================================

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=LocalMart
NEXT_PUBLIC_APP_DESCRIPTION=All local shops in one place
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/localmart
MONGODB_DB_NAME=localmart

# Authentication
AUTH_SECRET=your-super-secret-key-change-in-production
AUTH_TOKEN_EXPIRY=7d
AUTH_REFRESH_TOKEN_EXPIRY=30d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# =============================================================================
# Payment Gateways — bKash, Nagad, SSLCommerz
# =============================================================================
# Set the ENABLE_* flag to true AND provide credentials to activate a gateway.
ENABLE_BKASH=false
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta

ENABLE_NAGAD=false
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_KEY=
NAGAD_PG_PUBLIC_KEY=
NAGAD_BASE_URL=http://sandbox.mynagad.com:10080/remote-payment-gateway-1.0/api/dfs

ENABLE_SSLCOMMERZ=false
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_BASE_URL=https://sandbox.sslcommerz.com

# =============================================================================
# Loyalty & Rewards Program
# =============================================================================
# Points earned per taka spent (0.01 = 1 point per ৳100)
LOYALTY_EARN_RATE=0.01
# Taka value of one point when redeeming
LOYALTY_REDEEM_RATE=1
# Max share of an order that can be paid with points (0.2 = 20%)
LOYALTY_MAX_REDEEM_PCT=0.2
# Bonus points for the referrer when a referral places an order
LOYALTY_REFERRAL_BONUS=50

# =============================================================================
# Shipping Calculator
# =============================================================================
PLATFORM_DELIVERY_MIN_FEE=20
PLATFORM_DELIVERY_MAX_FEE=300

# =============================================================================
# Push Notifications (Web Push / VAPID)
# =============================================================================
NEXT_PUBLIC_ENABLE_PUSH=false
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@localmart.com

# =============================================================================
# Marketing Automation (SMS / Email)
# =============================================================================
SMS_API_KEY=
SMS_SENDER_ID=
SMS_BASE_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@localmart.com

# AI Provider (optional - features gracefully disabled when not configured)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_MAX_TOKENS=2000

# Maps Provider (optional)
MAPS_PROVIDER=
MAPS_API_KEY=

# SEO
NEXT_PUBLIC_OG_IMAGE=/og-default.png

# Feature Flags (overridden by database config)
ENABLE_COD=true
ENABLE_PLATFORM_DELIVERY=true
ENABLE_SELLER_DELIVERY=true
ENABLE_SELF_PICKUP=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE_MB=5
MAX_IMAGE_SIZE_MB=10

# Demo Mode
DEMO_MODE=true
DEMO_ADMIN_EMAIL=admin@localmart.com
DEMO_ADMIN_PASSWORD=Admin123!
