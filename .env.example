# =============================================================================
# LocalMart - Environment Configuration
# =============================================================================

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=LocalMart
NEXT_PUBLIC_APP_DESCRIPTION=All local shops in one place
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/localmart
MONGODB_DB_NAME=localmart

# Authentication
AUTH_SECRET=your-super-secret-key-change-in-production
AUTH_TOKEN_EXPIRY=7d
AUTH_REFRESH_TOKEN_EXPIRY=30d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# Payment - bKash (configure when available)
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta

# Payment - Nagad (configure when available)
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_KEY=
NAGAD_PG_PUBLIC_KEY=
NAGAD_BASE_URL=http://sandbox.mynagad.com:10080/remote-payment-gateway-1.0/api/dfs

# SMS Provider (configure when available)
SMS_API_KEY=
SMS_SENDER_ID=
SMS_BASE_URL=

# Email Provider (configure when available)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@localmart.com

# AI Provider (optional - features gracefully disabled when not configured)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_MAX_TOKENS=2000

# Maps Provider (optional)
MAPS_PROVIDER=
MAPS_API_KEY=

# Feature Flags (overridden by database config)
ENABLE_COD=true
ENABLE_BKASH=false
ENABLE_NAGAD=false
ENABLE_AI=false
ENABLE_PLATFORM_DELIVERY=true
ENABLE_SELLER_DELIVERY=true
ENABLE_SELF_PICKUP=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE_MB=5
MAX_IMAGE_SIZE_MB=10

# Demo Mode
DEMO_MODE=true
DEMO_ADMIN_EMAIL=admin@localmart.com
DEMO_ADMIN_PASSWORD=Admin123!
